# Copy this file to .env and fill in real values for a deployment. Local
# dev needs none of this - config.js falls back to src/config/configVars.js
# when a var isn't set here, so the app runs with zero setup out of the box.
# Anything set here overrides configVars.js's dev defaults.

NODE_ENV=production

# Public base URL of the deployed frontend - used to build links in emails
# (password reset, welcome email, ticket links).
APP_URL=https://app.yourdomain.com

# Comma-separated list of origins the API accepts requests from. Do not use
# "*" in production - list the real frontend domain(s) instead.
CORS_ORIGIN=https://app.yourdomain.com

# A real, hosted MongoDB (e.g. MongoDB Atlas) - never point production at a
# local mongod.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/scloudx?retryWrites=true&w=majority

# Generate a strong, random secret - do not reuse the checked-in dev value.
JWT_SECRET=<generate a long random string>
# The frontend has no refresh-token flow yet (see authSlice.js) - it never
# calls /auth/refresh-tokens, so shortening this will silently log users out
# every JWT_ACCESS_EXPIRATION_MINUTES with no way back in but a fresh login.
# Leave this long until that's built, or build it first.
JWT_ACCESS_EXPIRATION_MINUTES=300000
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SendGrid - see Settings > API Keys in the SendGrid dashboard (Restricted
# Access, Mail Send only) and Settings > Sender Authentication for verifying
# EMAIL_FROM.
API_KEY=<your SendGrid API key>
EMAIL_FROM=notifications@yourdomain.com
EMAIL_TO_SCLOUDX=ops@yourdomain.com
# EMAIL_TEST_RECIPIENT is intentionally not set here - leaving it unset in
# production is what allows real emails to reach their real recipients (see
# utils/mailer.js - test-mode redirection only applies when NODE_ENV isn't
# "production").
